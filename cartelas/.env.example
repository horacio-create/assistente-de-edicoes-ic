# Copie para .env. Nunca inclua uma chave em conversas ou cópias do trabalho.
CARTELAS_AI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Instagram: API com Facebook Login, para conta própria e Business Discovery.
# Use somente token de leitura; não são necessárias permissões de publicação.
CARTELAS_INSTAGRAM_ENABLED=0
META_IG_ACCESS_TOKEN=
META_IG_USER_ID=
# Informe a versão vigente habilitada no seu aplicativo Meta (formato vNN.N).
META_GRAPH_API_VERSION=
